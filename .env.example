LLM_PROVIDER=kimi
KIMI_API_KEY=sk-your-kimi-key-here
KIMI_MODEL=kimi-k2.6
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Optional fallback if you switch LLM_PROVIDER=openai.
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-5-mini

# Datadog LLM Observability for local development.
DD_LLMOBS_ENABLED=1
DD_LLMOBS_AGENTLESS_ENABLED=1
DD_LLMOBS_ML_APP=data-science-tutor
DD_SERVICE=data-science-tutor
DD_ENV=local
DD_APM_TRACING_ENABLED=false
DD_OPENAI_SPAN_PROMPT_COMPLETION_SAMPLE_RATE=0
DD_OPENAI_LOGS_ENABLED=false
DD_LLMOBS_CAPTURE_IO=1
DD_SITE=datadoghq.com
DD_API_KEY=your-datadog-api-key
